{
  "ConnectionStrings": {
    // Windows Authentication (no password needed – uses your Windows login)
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=FixMateDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"

    // ── SQL Server Auth alternative (set in user-secrets for real passwords) ──
    // "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=FixMateDb;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Jwt": {
    "Key": "CHANGE-ME-IN-USER-SECRETS-min32chars!!",
    "Issuer": "FixMateAPI",
    "Audience": "FixMateClients",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },

  "Cloudinary": {
    "CloudName": "CHANGE-ME",
    "ApiKey": "CHANGE-ME",
    "ApiSecret": "CHANGE-ME-IN-USER-SECRETS"
  },

  "Razorpay": {
    "KeyId": "CHANGE-ME",
    "KeySecret": "CHANGE-ME-IN-USER-SECRETS",
    "WebhookSecret": "CHANGE-ME-IN-USER-SECRETS"
  },

  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "noreply@fixmate.com",
    "Password": "CHANGE-ME-IN-USER-SECRETS",
    "FromName": "FixMate",
    "FromAddress": "noreply@fixmate.com"
  },

  "Firebase": {
    "ProjectId": "CHANGE-ME",
    "ServiceAccountKeyPath": "firebase-service-account.json"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fixmate-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },

  "AllowedOrigins": [
    "http://localhost:5173",
    "https://localhost:5173",
    "https://skyfix.skyttus.in",
    "http://skyfix.skyttus.in"
  ],

  "AllowedHosts": "*"
}
